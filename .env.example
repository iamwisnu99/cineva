# ========================================================
# CINEVA CONFIGURATION & SECRETS
# ========================================================

# Supabase Database Configuration (SERVER-SIDE ONLY)
# CRITICAL SECURITY NOTE: Never use NEXT_PUBLIC_ for Supabase credentials!
# Keeping these without NEXT_PUBLIC_ guarantees they are NEVER bundled into 
# client JavaScript and CANNOT be viewed in browser DevTools.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Secret key used for cryptographically signing HTTP-Only session cookies (admin & viewer)
ADMIN_SESSION_SECRET=cineva-secret-super-secure-key-2026-production

# Gmail SMTP Configuration for Viewer OTP Delivery
# Use a 16-character App Password generated from Google Account (Security -> 2-Step Verification -> App Passwords)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Video CDN Provider (cdn | r2 | bunny | gdrive)
VIDEO_PROVIDER=cdn
VIDEO_CDN_BASE_URL=
SUBTITLE_CDN_BASE_URL=
